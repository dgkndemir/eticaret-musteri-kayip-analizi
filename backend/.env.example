# Google Gemini API Anahtarı (Canlı Bulut LLM için)
# Ücretsiz API anahtarı almak için: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (İsteğe bağlı) Kullanmak istediğiniz belirli model sürümü
# Belirtilmezse sistem güncel aktif modelleri sırasıyla otomatik dener:
# (gemini-2.5-flash -> gemini-2.0-flash -> gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
